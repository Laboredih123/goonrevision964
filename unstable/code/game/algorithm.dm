	var/obj/item/weapon/card/id/C = new /obj/item/weapon/card/id(M)
	C.registered = M.spawn_name
	C.assignment = rank
	C.name = "[C.registered]'s ID Card ([C.assignment])"
	C.access = get_access(C.assignment)
	M.equip_if_possible(C, M.SLOT_ID)
	M.equip_if_possible(new /obj/item/weapon/pen(M), M.SLOT_R_STORE)
	M.equip_if_possible(new /obj/item/weapon/radio/signaler(M), M.SLOT_BELT)

	if(rank == "Captain")
		world << "<b>[M] is the captain!</b>"
	src << "<B>You are the [rank].</B>"

	M.client = src.client
	del(src)

/proc/AutoUpdateAI(obj/subject)
	if (subject!=null)
		for(var/mob/silicon/ai/M in world)
			if ((M.client && M.machine == subject))
				subject.interact(M)
