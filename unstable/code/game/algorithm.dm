

/world/New()

	..()
	spawn( 0 )
		SetupOccupationsList()
		return
	return

/mob/prespawn/proc/Assign_Rank(rank, joined_late)
	var/startloc = null
	if(!joined_late)
		var/obj/S = locate("start*[rank]")
		if ((istype(S, /obj/start) && istype(S.loc, /turf) && !( ctf )))
			startloc = S.loc

	if (rank == "AI")
		var/mob/silicon/ai/A = new()
		A.loc = startloc
		A.client = src.client
		del(src)
		return

	var/mob/carbon/M = new(startloc)

	M.equip_if_possible(new /obj/item/weapon/radio/headset(M), M.SLOT_HEADSET)
	M.equip_if_possible(new /obj/item/weapon/storage/backpack(M), M.SLOT_BACK)
	switch(rank)
		if("Research Assistant")
			M.equip_if_possible(new /obj/item/weapon/clothing/under/white(M), M.SLOT_JUMPSUIT)
			M.equip_if_possible(new /obj/item/weapon/clothing/shoes/white(M), M.SLOT_SHOES)
			M.equip_if_possible(new /obj/item/weapon/clothing/suit/labcoat(M), M.SLOT_SUIT)
			M.equip_if_possible(new /obj/item/weapon/clipboard(M), M.SLOT_L_HAND)
		if("Technical Assistant")
			M.equip_if_possible(new /obj/item/weapon/clothing/under/yellow(M), M.SLOT_JUMPSUIT)
			M.equip_if_possible(new /obj/item/weapon/clothing/shoes/orange(M), M.SLOT_SHOES)
			M.equip_if_possible(new /obj/item/weapon/storage/toolbox(M), M.SLOT_L_HAND)
			M.equip_if_possible(new /obj/item/weapon/crowbar(M), M.SLOT_IN_BACKPACK)
		if("Staff Assistant")
			M.equip_if_possible(new /obj/item/weapon/clothing/under/red(M), M.SLOT_JUMPSUIT)
			M.equip_if_possible(new /obj/item/weapon/clothing/shoes/brown(M), M.SLOT_SHOES)
